# ============================================
# SmartIGLab Backend - Configuration Template
# ============================================
# Copier ce fichier en .env et remplir les valeurs

# === SERVEUR ===
HOST=0.0.0.0                    # Écoute sur toutes les interfaces
PORT=8000                       # Port HTTP
DEBUG=False                     # Mode debug (logs verbeux)

# === SALLE ===
ROOM_CAPACITY=40                # Capacité maximale de l'auditoire

# === GPIO RASPBERRY PI (Numérotation BCM) ===
DHT22_PIN=4                     # Capteur température/humidité
REED_SWITCH_PIN=17              # Détecteur fenêtre
SENSOR_READ_INTERVAL=10.0       # Lecture toutes les 10 secondes

# === VISION YOLO (Comptage personnes) ===
VISION_ENABLED=True             # Activer le système de vision
CAM_INDEX=0                     # Index caméra USB (/dev/video0)
CAM_WIDTH=640                   # Résolution largeur
CAM_HEIGHT=480                  # Résolution hauteur
YOLO_MODEL=yolov8n.pt          # Modèle YOLO (nano pour Raspberry Pi)
YOLO_CONF=0.5                   # Seuil de confiance (0.0-1.0)
YOLO_IMGSZ=640                  # Taille image pour YOLO
UPDATE_INTERVAL=0.5             # FPS vision (~2 FPS)

# === HYPERPLANNING (Emploi du temps) ===
HYPERPLANNING_ENABLED=True      # Activer le module planning
HYPERPLANNING_URL=              # URL iCal (prioritaire si renseignée)
HYPERPLANNING_ROOM_ID=          # ID salle (optionnel)
HYPERPLANNING_REFRESH_INTERVAL=60.0  # Rafraîchissement (1min)


# === FRONTEND ===
DASHBOARD_USERNAME=votre_login
DASHBOARD_PASSWORD=votre_mot_de_passe_fort

# === SÉCURITÉ ===
# IMPORTANT: Générer une clé unique avec: openssl rand -hex 64 qui sera utilisée pour l'authentification API
API_KEY=CHANGER_CETTE_CLE_AVANT_PRODUCTION

# === CORS (Dashboard web) ===
CORS_ORIGINS=*                  # Origins autorisées (* = toutes)
