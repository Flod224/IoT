# Configuration ESP32 Display - À personnaliser

# ===== WI-FI =====
# SSID du point d'accès Raspberry Pi
WIFI_SSID=Raspberry_Pi_AP

# Mot de passe Wi-Fi
WIFI_PASS=smartiglab2025

# ===== API =====
# URL du backend sur Raspberry Pi
API_URL=http://192.168.1.10:8000/status

# Intervalle de rafraîchissement (millisecondes)
REFRESH_INTERVAL=2000

# ===== DISPLAY =====
# Rotation écran (0-3)
# 0 = portrait, 1 = paysage, 2 = portrait inversé, 3 = paysage inversé
SCREEN_ROTATION=0

# Luminosité rétroéclairage (0-255)
BACKLIGHT_BRIGHTNESS=200
