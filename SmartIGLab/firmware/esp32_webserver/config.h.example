/*
 * ============================================
 * SmartIGLab ESP32 - Configuration Template
 * ============================================
 * 
 * Instructions:
 *   1. Copier ce fichier en "config.h"
 *   2. Remplir vos identifiants WiFi et API
 *   3. Ne PAS commiter config.h dans Git
 */

#ifndef CONFIG_H
#define CONFIG_H

// === WIFI ===
// IMPORTANT: Même réseau que le Raspberry Pi backend
#define WIFI_SSID "VotreSSID"              // Nom du réseau WiFi
#define WIFI_PASSWORD "VotreMotDePasse"    // Mot de passe WiFi

// === API BACKEND ===
// URL du backend Raspberry Pi (endpoint /status)
// Format: http://IP_RASPBERRY:8000/status
#define API_URL "http://192.168.1.100:8000/status"

// Clé API pour authentification
// IMPORTANT: Doit correspondre à API_KEY dans backend/app/.env
// Générer avec: openssl rand -hex 64
#define API_KEY "VOTRE_CLE_API_ICI"

// === PERFORMANCE ===
// Intervalle de rafraîchissement des données (millisecondes)
// Recommandé: 5000 ms (5 secondes)
// Minimum: 3000 ms pour éviter surcharge backend
#define FETCH_INTERVAL 5000

#endif
