# Configuration backend SmartIGLab

# Serveur
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Capacité salle
ROOM_CAPACITY=40

# GPIO Pins (BCM numbering)
DHT22_PIN=4
REED_SWITCH_PIN=17

# Intervalle lecture capteurs (secondes)
SENSOR_READ_INTERVAL=10

# Vision YOLO
VISION_ENABLED=True
CAM_INDEX=0
CAM_WIDTH=640
CAM_HEIGHT=480
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.5
YOLO_IMGSZ=640
UPDATE_INTERVAL=0.5

# Hyperplanning (à configurer)
HYPERPLANNING_ENABLED=False
HYPERPLANNING_URL=
HYPERPLANNING_ROOM_ID=
HYPERPLANNING_REFRESH_INTERVAL=300

# CORS (pour dashboard web)
CORS_ORIGINS=*
