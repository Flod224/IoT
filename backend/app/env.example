# ============================================
# SmartIGLab Backend - Configuration Template
# ============================================
# Copier ce fichier en .env et remplir les valeurs

# === AUTHENTIFICATION UTILISATEUR SIMPLE ===
# Accès dashboard uniquement
DASHBOARD_USERNAME=user
DASHBOARD_PASSWORD=votre_mot_de_passe_user

# === AUTHENTIFICATION ADMINISTRATEUR ===
# Accès interface admin + dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=votre_mot_de_passe_admin_fort

# === API KEY (pour Node-RED et services internes) ===
API_KEY=ici_votre_api_key_identique_a_nodered

# === BASE DE DONNÉES ===
DB_RETENTION_DAYS=30