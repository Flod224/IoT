    {
        "id": "1c9887b2da8b0798",
        "type": "function",
        "z": "4732fa159cf57b5a",
        "name": "Alert temp",
        "func": "// lecture du payload du DHT22\nlet temp = msg.temperature;\n\n// Heure actuelle (pour info dans le mail)\nlet now = new Date();\n\n// Condition : température > 50°C\nif (temp > 50) {\n    msg.topic = \"SmartIGLab – Température critique\";\n    msg.payload = `\nBonjour,\n\nLe système SmartIGLab a détecté une température élevée dans l'auditoire.\n\n━━━━━━━━━━━━━━━━━━━━━━\n📍 Localisation :\nAuditoire IGLab  \nRue de Houdain 9  \n7000 Mons  \n\nÉvénement :\nLa température actuelle est **${temp}°C**, ce qui dépasse le seuil critique de 50°C.\n\nHeure de détection :\n${now.toLocaleString(\"fr-BE\")}\n━━━━━━━━━━━━━━━━━━━━━━\n\nMerci de vérifier la situation dès que possible.\n\nCordialement,\nSmartIGLab\n`;\n\n    return msg;\n}\n\n// Sinon, ne rien envoyer\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
