    {
        "id": "eeba17178b621220",
        "type": "function",
        "z": "4732fa159cf57b5a",
        "name": "Alert window",
        "func": "// État venant du capteur\nlet state = msg.windowOpen;\n\n// Heure actuelle\nlet now = new Date();\n\n// Heure limite notification (21:00)\nlet notifHour = 21;\nlet notifMinute = 0;\n\n// Vérification horaire\nlet afterNotifTime =\n    now.getHours() > notifHour ||\n    (now.getHours() === notifHour && now.getMinutes() >= notifMinute);\n\nif (state && afterNotifTime) {\n\n    msg.topic = \"SmartIGLab – Fenêtre ouverte après 21h\";\n\n    msg.payload = `\nBonjour,\n\nUne alerte a été détectée par le système SmartIGLab.\n\n━━━━━━━━━━━━━━━━━━━━━━\n📍 Localisation :\nAuditoire IGLab  \nRue de Houdain 9  \n7000 Mons  \n\nÉvénement :\nUne fenêtre est actuellement **OUVERTE** après 21h.\n\nHeure de détection :\n${now.toLocaleString(\"fr-BE\")}\n━━━━━━━━━━━━━━━━━━━━━━\n\nMerci de vérifier la situation dès que possible.\n\nCordialement,\n\nSmartIGLab  \n`;\n\n    return msg;\n}\n\n// Ne rien envoyer si condition non remplie\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 180,
